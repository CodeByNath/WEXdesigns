{
  "name": "@weerax/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "pnpm --filter @weerax/schemas build && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --filter @weerax/schemas build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @weerax/schemas build && pnpm --filter @weerax/adapters build && pnpm build && node --test test/*.test.mjs",
    "check": "pnpm type-check && pnpm test"
  },
  "dependencies": {
    "@weerax/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.1"
  }
}
