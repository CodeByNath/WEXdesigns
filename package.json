{
  "name": "weerax-studios",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "lint": "pnpm audit:foundation && turbo run lint",
    "test": "turbo run test",
    "check": "pnpm audit:foundation && turbo run check",
    "dev": "turbo run dev",
    "audit:foundation": "node tooling/scripts/validate-foundation.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.10",
    "typescript": "7.0.2"
  }
}
