{
  "name": "@weerax/web-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:studio-host": "vite build --config vite.studio-host.config.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build:studio-host && node --test test/*.test.mjs",
    "test:studio-host": "pnpm build:studio-host && node --test test/studio-host.test.mjs",
    "check": "pnpm type-check && pnpm test",
    "dev": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "@weerax/catalogue": "workspace:*",
    "@weerax/schemas": "workspace:*",
    "@weerax/ui": "workspace:*",
    "@weerax/wex": "workspace:*"
  },
  "devDependencies": {
    "vite": "8.2.2"
  }
}
